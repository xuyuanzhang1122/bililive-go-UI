{
  "name": "bililive-go-ui",
  "version": "1.3.6",
  "description": "bililive-go 优化版 — 多平台直播录制 + 视频库管理 + iOS App 接入",
  "main": "index.js",
  "bin": {
    "bililive-go-ui": "scripts/npm-install.mjs",
    "bililive-go": "scripts/npm-install.mjs"
  },
  "files": [
    "scripts/npm-install.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuyuanzhang1122/bililive-go-UI.git"
  },
  "bugs": {
    "url": "https://github.com/xuyuanzhang1122/bililive-go-UI/issues"
  },
  "homepage": "https://github.com/xuyuanzhang1122/bililive-go-UI#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^25.0.10",
    "dotenv": "^17.2.3"
  },
  "scripts": {
    "generate:web-api": "node scripts/generate-web-api.mjs",
    "install:browser": "npx playwright install chromium",
    "report": "node scripts/report-server.js",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "keywords": [
    "bililive-go",
    "live-recording",
    "installer",
    "cli"
  ],
