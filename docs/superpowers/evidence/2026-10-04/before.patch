+		if e != nil {
+			return nil, e
+		}
+		if !info.Mode().IsRegular() || info.Size() == 0 {
+			return nil, fmt.Errorf("分片缺失或为空")
+		}
+		count++
+		pending = false
+		if !complete {
+			return data, nil
+		}
+	}
+	if count == 0 || pending || !ended {
+		return nil, fmt.Errorf("HLS 清单未完整发布")
+	}
